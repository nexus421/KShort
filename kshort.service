[Unit]
Description=KShort - URL shortener
After=network-online.target
Wants=network-online.target
# At most 5 starts within 2 minutes, then systemd gives up (unit "failed", result "start-limit-hit").
# Start again after fixing the cause: `systemctl reset-failed kshort && systemctl start kshort`
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# A throwaway user for every run instead of root: read-only file system, /root and /home read-only, private /tmp.
# No User= line: naming an existing user (e.g. root) makes systemd use that one instead of a throwaway user.
DynamicUser=yes
# The only writable place: /var/lib/kshort survives restarts and holds the SQLite database (databasePath)
StateDirectory=kshort
# systemd reads the config as root and hands the service a private copy in %d (the credentials directory),
# so config.json stays readable by root only (chmod 600)
LoadCredential=config.json:/root/kshort/config.json
# The service user must be able to read the jar. Below /root (mode 700) that takes `chmod 711 /root`.
ExecStart=/usr/bin/java -jar /root/kshort/kshort.jar config=%d/config.json
# 1 (start failed, e.g. the address is not assigned yet at boot) or a crash: try again after 10 s
Restart=on-failure
RestartSec=10
# 78 (EX_CONFIG): the config file was rejected. Fix it, then `systemctl restart kshort`
RestartPreventExitStatus=78
# 143: the JVM's exit code after a SIGTERM (systemctl stop), which is a clean stop, not a failure
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
